# Callback / Lead emails
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

FROM_EMAIL="Gabriel PERBOST <gabriel.perbost@gp-finances.fr>"
INTERNAL_LEADS_EMAIL=gabriel.perbost@gp-finances.fr
# Alerte operationnelle en cas d'echec d'envoi d'un email transactionnel.
MAIL_FAILURE_ALERT_TO=contact@gp-finances.fr
# Adresse de rebond (MAIL FROM SMTP envelope) pour recevoir les bounces/NDR.
SMTP_BOUNCE_ADDRESS=contact@gp-finances.fr
SMTP_MOCK=true
# In production, SMTP_MOCK is ignored unless this is true.
ALLOW_SMTP_MOCK_IN_PROD=false
LEADS_EXPORT_SECRET=change_me

# Depot documents (Supabase + Monday/Make)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PORTAL_AUTH_COOKIE_SECRET=generate_a_long_random_secret_min_32_chars
# Keep false in production. Set true only for temporary backward compatibility.
ALLOW_LEGACY_PORTAL_TOKEN_INPUT=false

# Base URL used in generated customer links
NEXT_PUBLIC_BASE_URL=https://gp-finances.fr

# Internal simulator access (required to unlock /tarificateur-gp)
SIMULATEUR_GP_PASSWORD=change_me_with_a_strong_password
# Optional: override cookie signing secret (recommended in production)
SIMULATEUR_GP_COOKIE_SECRET=another_long_random_secret_min_16_chars

# Optional: analytics IDs
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
NEXT_PUBLIC_PER_CALENDLY_URL=https://calendly.com/gabriel-perbost-gp-finances/votre-etude-d-optimisation-fiscale

# PER Tally -> Monday/email funnel
TALLY_WEBHOOK_SECRET=change_me
PER_TALLY_API_KEY=your_tally_api_key
PER_TALLY_FORM_ID=your_tally_form_id
PER_TALLY_PARTIALS_SECRET=change_me
PER_TALLY_PARTIALS_LOOKBACK_HOURS=72
PER_TALLY_PARTIALS_LIMIT=100

# Optional: lead magnet URL sent in PER confirmation email
# If omitted, fallback URL is: https://gp-finances.fr/lead-magnets/per/guide-per-7-erreurs.pdf
PER_LEAD_MAGNET_URL=https://gp-finances.fr/lead-magnets/per/guide-per-7-erreurs.pdf

# Secret for Monday/Make -> /api/webhook-monday
WEBHOOK_SECRET=change_me

# Optional: token lifetime in days for depot links (default 30)
DEPOT_TOKEN_TTL_DAYS=30

# Optional: max file size in MB for document upload (default 10)
DEPOT_MAX_FILE_MB=10

# Optional: reminder cron settings
DEPOT_REMINDER_CRON_SECRET=change_me
DEPOT_REMINDER_MAX_ATTEMPTS=4
DEPOT_REMINDER_BATCH_SIZE=80

# Optional: Make webhook triggered once customer clicks "Transférer"
